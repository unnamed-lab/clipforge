# ---- Clipforge local configuration -------------------------------------------
# Copy to .env (web app) — the worker reads process env directly.

# Where the Python worker listens. Keep it on loopback.
CLIPFORGE_WORKER_URL=http://127.0.0.1:8788
CLIPFORGE_WORKER_HOST=127.0.0.1
CLIPFORGE_WORKER_PORT=8788

# Runtime data root (database, uploads, renders, models). Relative to repo root.
CLIPFORGE_DATA_DIR=./data

# Shared secret for web <-> worker. Auto-generated at data/worker-token when absent.
# CLIPFORGE_WORKER_TOKEN=

# ---- Limits ------------------------------------------------------------------
CLIPFORGE_MAX_UPLOAD_MB=2048
CLIPFORGE_MAX_DURATION_MINUTES=360
CLIPFORGE_MIN_FREE_GB=2

# ---- Transcription -----------------------------------------------------------
# tiny | base | small | medium   (default small: ~480 MB, best quality/speed mix
# for a 4-core CPU. Use base or tiny for a faster first run.)
CLIPFORGE_WHISPER_MODEL=small
CLIPFORGE_WHISPER_DEVICE=cpu
CLIPFORGE_WHISPER_COMPUTE_TYPE=int8

# ---- Optional LLM rescoring (OFF by default; baseline scorer needs no keys) ---
CLIPFORGE_LLM_ENABLED=false
# Any OpenAI-compatible endpoint, e.g. http://127.0.0.1:8080/v1 or https://api.example.com/v1
CLIPFORGE_LLM_BASE_URL=
CLIPFORGE_LLM_MODEL=
CLIPFORGE_LLM_API_KEY=
CLIPFORGE_LLM_TIMEOUT_SECONDS=60
