# Copy to `.env` for local development or `docker compose`.
# This file contains placeholders only. Never commit a real token or key.

# ---- Local host development --------------------------------------------------
# Both processes run on the host. Keep the worker on loopback.
CLIPFORGE_WORKER_URL=http://127.0.0.1:8788
CLIPFORGE_WORKER_HOST=127.0.0.1
CLIPFORGE_WORKER_PORT=8788

# Runtime data root (SQLite, uploads, renders, models). Relative to repo root.
CLIPFORGE_DATA_DIR=./data

# Shared secret for web <-> worker. When empty, the worker generates
# data/worker-token on first boot and the web app reads that file.
# Docker Compose and hosted deployments require an explicit value.
# CLIPFORGE_WORKER_TOKEN=

# ---- Docker Compose ----------------------------------------------------------
# Required by compose.yaml. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CLIPFORGE_WORKER_TOKEN=replace-with-a-generated-secret
# CLIPFORGE_WEB_PORT=3000

# ---- Limits ------------------------------------------------------------------
CLIPFORGE_MAX_UPLOAD_MB=2048
CLIPFORGE_MAX_DURATION_MINUTES=360
# Headroom kept free on the data volume; uploads reserve their own estimate.
CLIPFORGE_DISK_RESERVE_MB=512

# ---- Transcription -----------------------------------------------------------
# tiny | base | small | medium   (base is the hosted default: ~140 MB)
CLIPFORGE_WHISPER_MODEL=small
CLIPFORGE_WHISPER_DEVICE=cpu
CLIPFORGE_WHISPER_COMPUTE_TYPE=int8

# ---- Optional LLM rescoring (OFF by default; baseline scorer needs no keys) ---
CLIPFORGE_LLM_ENABLED=false
# Any OpenAI-compatible endpoint. Transcript text leaves the device only when
# this is enabled and the user consents in the UI.
CLIPFORGE_LLM_BASE_URL=
CLIPFORGE_LLM_MODEL=
CLIPFORGE_LLM_API_KEY=
CLIPFORGE_LLM_TIMEOUT_SECONDS=60

# ---- Optional Content Test Library connectors --------------------------------
# Official APIs only. Leave blank to report the connector as unavailable.
CLIPFORGE_YOUTUBE_API_KEY=
CLIPFORGE_TWITCH_CLIENT_ID=
CLIPFORGE_TWITCH_CLIENT_SECRET=

# ---- Storage -----------------------------------------------------------------
# local (default) keeps media under CLIPFORGE_DATA_DIR.
# supabase stores sources, renders, sidecar captions and brand assets in a
# private Supabase Storage bucket. SQLite, the model cache and scratch files
# stay on the worker disk.
CLIPFORGE_STORAGE_BACKEND=local

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# For a self-hosted Supabase stack in Docker, use an address the *worker
# container* can reach (host.docker.internal on Windows/macOS, or the service
# name on Linux). Do not use localhost from inside a container.
CLIPFORGE_SUPABASE_URL=

# Service-role key. Required when the backend is supabase.
# Server-side only: never put this in a NEXT_PUBLIC_* variable or the browser.
CLIPFORGE_SUPABASE_SERVICE_KEY=

# Must already exist and be PRIVATE. Create it in Storage > Buckets.
CLIPFORGE_SUPABASE_BUCKET=clipforge

# Storage API path prefix. Hosted Supabase and Supabase's Kong gateway expose the
# Storage API under /storage/v1. Leave this empty only when the URL points
# directly at supabase/storage-api:latest (for example http://storage-api:5000).
CLIPFORGE_SUPABASE_STORAGE_PREFIX=/storage/v1
CLIPFORGE_SUPABASE_TIMEOUT_SECONDS=60

# ---- Hosted plumbing ---------------------------------------------------------
# Render injects PORT. Docker images default to 8788; do not set PORT by hand
# for local host development.
# CLIPFORGE_CORS_ORIGINS=https://your-web-service.onrender.com
