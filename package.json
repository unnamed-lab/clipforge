{
  "name": "clipforge",
  "version": "0.1.0",
  "private": true,
  "description": "Free-first AI video repurposing studio (local processing)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @clipforge/web dev",
    "dev:worker": "pnpm run worker:dev",
    "worker:dev": "node scripts/worker.mjs dev",
    "build": "pnpm --filter @clipforge/web build",
    "start": "pnpm --filter @clipforge/web start",
    "lint": "pnpm --filter @clipforge/web lint",
    "typecheck": "pnpm --filter @clipforge/web typecheck",
    "test": "pnpm --filter @clipforge/web test",
    "test:worker": "node scripts/worker.mjs test",
    "lint:worker": "node scripts/worker.mjs lint",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "verify:docker": "node scripts/docker-verify.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
